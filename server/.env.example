# ===========================================================
# VetBot · Configuración del servidor (copiá a .env)
# ===========================================================

# Puerto en el que escucha la API (dev: 4000).
PORT=4000

# "production" en el servidor real (Render/Railway/Docker/etc). Con esto en
# "production", el server VALIDA al arrancar que JWT_SECRET y CORS_ORIGIN
# estén configurados de forma segura, y aborta el arranque si no lo están
# (en cualquier otro valor solo advierte, para no trabar el dev local).
NODE_ENV=development

# === Seguridad ===
# IMPORTANTE: generá un secreto largo en producción: `openssl rand -hex 32`
# (mínimo 32 caracteres; con NODE_ENV=production el server rechaza arrancar
# si queda en este valor de ejemplo o es demasiado corto).
JWT_SECRET=cambia_este_secreto

# Detrás de un proxy reverso (Render/Railway/Nginx): true.
# Habilita req.protocol correcto y confía en X-Forwarded-*. En dev dejalo vacío.
TRUST_PROXY=false

# Dominios permitidos en CORS, separados por coma (ej: https://vetibot.app,https://www.vetibot.app).
# Vacío = se permite todo (SOLO para dev local; con NODE_ENV=production el
# server rechaza arrancar si queda vacío).
CORS_ORIGIN=

# === IA (asistente de triage) ===
# API key de OpenAI (o de OpenRouter si usás OPENAI_BASE_URL).
# Sin key, el bot responde con el fallback determinístico (no llama a la IA).
OPENAI_API_KEY=
# Modelo PRINCIPAL. Cualquiera de OpenRouter. Ej sin :free si usás un modelo de pago.
OPENAI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Base URL del proveedor. Para modelos gratis de OpenRouter usá:
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --- Cadena de modelos free (fallback) ---
# Si el modelo principal falla (caído, saturado, 404), el bot prueba OTROS
# modelos gratuitos de OpenRouter en cadena. Por defecto los DESCUBRE solos
# desde el catálogo de OpenRouter (OPENROUTER_AUTO_FREE=true), así no dependés
# de uno solo. Podés fijar una lista manual acá (sep. por coma) como refuerzo:
# OPENROUTER_FREE_MODELS=meta-llama/llama-3.3-70b-instruct:free,qwen/qwen2.5-72b-instruct:free
# Para apagar el autodescubrimiento: 
# OPENROUTER_AUTO_FREE=false
# Máximo de modelos autodescubiertos que se prueban por request:
# OPENROUTER_MAX_FREE=12

# --- Velocidad de respuesta (cuando el primario falla) ---
# El usuario ve el indicador "pensando" mientras se prueba la cadena. Estos
# límites controlan que responda cuanto antes:
#   • Techo TOTAL de la cadena (ms): pasada esa espera, se responde igual (con
#     lo que haya o el fallback local). 
#   OPENAI_CHAIN_TIMEOUT_MS=45000
#   • Timeout por intento (ms): si un modelo tarda más, se descarta y sigue.
#   OPENAI_ATTEMPT_TIMEOUT_MS=18000
#   • Ventana de gracia del modelo principal (ms): si Nvidia no responde en este
#     tiempo, los fallbacks se prueban EN PARALELO y gana el primero que responda.
#   OPENAI_PRIMARY_GRACE_MS=9000

# === Mensajes de voz (transcripción audio → texto en el chat) ===
# Sin key: el botón de micrófono queda OCULTO en el chat (no se rompe nada,
# simplemente no se ofrece). Con key: Whisper transcribe el audio y lo carga
# en el campo de texto para que el usuario lo revise antes de enviar.
# Groq expone un endpoint compatible con OpenAI (Whisper) con tier gratuito
# generoso — conseguí una key gratis en https://console.groq.com/keys
# (OJO: esto es DISTINTO de OPENAI_API_KEY/OPENROUTER de arriba — OpenRouter
# no tiene endpoint de audio, por eso hace falta un proveedor aparte).
TRANSCRIBE_API_KEY=
# TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
# TRANSCRIBE_MODEL=whisper-large-v3-turbo

# === Veterinarias (OpenStreetMap / Overpass) ===
# Endpoint de Overpass. Por defecto usa kumi.systems y cae a otros públicos.
# OVERPASS_URL=https://overpass.kumi.systems/api/interpreter

# === Convenios B2B (JSON overlay) ===
# Archivo con veterinarias con convenio (ver data/sponsors.example.json).
# SPONSORS_FILE=./server/data/sponsors.json

# === Base de datos ===
# Ruta del archivo SQLite. Por defecto: server/data/vetibot.db
# DB_PATH=./server/data/vetibot.db

# === Mercado Pago (B2B: veterinarias) ===
# Reemplaza a Stripe para este flujo (clientes 100% argentinos). Sacá tus
# credenciales en el Panel de Desarrolladores de MP > "Tus integraciones":
# https://www.mercadopago.com.ar/developers/panel
# En desarrollo usá las credenciales de PRUEBA (empiezan con "TEST-"), NUNCA
# las de producción acá. El Access Token es secreto (no lo compartas/pegues
# en chats ni lo subas a git); el Public Key es seguro de exponer al cliente.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Firma del webhook (header x-signature), se obtiene al configurar la URL de
# notificaciones en el mismo panel > Webhooks > Configurar notificaciones.
MP_WEBHOOK_SECRET=

# === Stripe (legacy, no se usa para B2B — ver Mercado Pago arriba) ===
# En desarrollo usá claves de TEST (sk_test_ / pk_test_). Vacías = modo sandbox.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# MONEDA y precios (centavos).
STRIPE_CURRENCY=usd
TIER_PRICE_1=2900
TIER_PRICE_2=7900
TIER_PRICE_3=14900

# === Notificaciones push (Web Push / VAPID) ===
# URL pública de la app (para construir el link de la notificación).
APP_URL=http://localhost:5173
# Generá el par de claves: `npx web-push generate-vapid-keys`
VAPID_SUBJECT=mailto:no-reply@vetibot.app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# === Build del frontend que sirve el server en producción ===
# CLIENT_DIST=./client/dist